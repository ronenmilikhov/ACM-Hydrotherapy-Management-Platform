{
  "expo": {
    "name": "MyApp",
    "slug": "MyApp",
    "privacy": "public",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shachar2003.MyApp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use your camera for chat photo attachments.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos for chat attachments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.shachar2003.MyApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for chat photo attachments.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for chat attachments."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "huntingforeu",
    "extra": {
      "eas": {
        "projectId": "ff170d0a-60b6-438d-85d9-d9ec567eb68f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ff170d0a-60b6-438d-85d9-d9ec567eb68f"
    }
  }
}
