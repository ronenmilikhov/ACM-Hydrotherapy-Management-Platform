{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ReactServerSide",
    "Audience": "ReactProjectClient",
    "SecretKey": "SET_A_LONG_RANDOM_SECRET_KEY",
    "ExpiryMinutes": 180
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "ApiKey": "SET_OPENROUTER_API_KEY",
    "Model": "openrouter/free",
    "BaseUrl": "https://openrouter.ai/api/v1/chat/completions"
  },
  "AWS": {
    "Region": "eu-north-1",
    "DynamoDb": {
      "TablePrefix": "acm-",
      "UseTablePrefix": false
    },
    "S3": {
      "BucketName": "SET_S3_BUCKET_NAME",
      "ChatAttachmentsPrefix": "chat-attachments"
    },
    "Cognito": {
      "UserPoolId": "SET_COGNITO_USER_POOL_ID",
      "AppClientId": "SET_COGNITO_APP_CLIENT_ID"
    }
  }
}